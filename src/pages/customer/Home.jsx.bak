import React, { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import axios from "axios";

function Home() {
  const [restaurants, setRestaurants] = useState([]);
  const [loadingRestaurants, setLoadingRestaurants] = useState(true);

  const categories = [
    {
      icon: "🍔",
      name: "Burgers",
      text: "Juicy & delicious",
    },
    {
      icon: "🍕",
      name: "Pizza",
      text: "Hot & cheesy",
    },
    {
      icon: "🍗",
      name: "Chicken",
      text: "Crispy & tasty",
    },
    {
      icon: "🍜",
      name: "Noodles",
      text: "Fresh & spicy",
    },
    {
      icon: "🍰",
      name: "Desserts",
      text: "Sweet moments",
    },
    {
      icon: "🥤",
      name: "Drinks",
      text: "Cool & refreshing",
    },
  ];

  // ==========================================
  // LOAD RESTAURANTS FROM DATABASE
  // ==========================================
  useEffect(() => {
    fetchRestaurants();
  }, []);

  const fetchRestaurants = async () => {
    try {
      const response = await axios.get(
        "http://127.0.0.1:8000/api/restaurants"
      );

      console.log("Restaurants:", response.data);

      setRestaurants(response.data.restaurants || []);
    } catch (error) {
      console.error(
        "Failed to load restaurants:",
        error.response?.data || error.message
      );

      setRestaurants([]);
    } finally {
      setLoadingRestaurants(false);
    }
  };

  return (
    <div className="food-home">

      {/* ================= HERO ================= */}

      <section className="hero-section">

        <div className="hero-overlay"></div>

        <div className="container hero-content">

          <div className="row align-items-center g-4">

            {/* HERO TEXT */}

            <div className="col-12 col-lg-7">

              <span className="hero-small">
                🔥 Delicious food is waiting
              </span>

              <h1>
                Your favorite food,
                <br />
                <span>delivered fast.</span>
              </h1>

              <p>
                Discover the best restaurants and hotels
                around you. Order your favorite meals and
                enjoy them at your doorstep.
              </p>

              <div className="hero-buttons">

                <Link
                  to="/restaurants"
                  className="hero-primary-btn"
                >
                  🍔 Order Now
                </Link>

                <Link
                  to="/restaurants"
                  className="hero-secondary-btn"
                >
                  Explore Restaurants →
                </Link>

              </div>

              <div className="hero-stats">

                <div>
                  <strong>{restaurants.length}+</strong>
                  <span>Restaurants</span>
                </div>

                <div>
                  <strong>50K+</strong>
                  <span>Happy Customers</span>
                </div>

                <div>
                  <strong>30 min</strong>
                  <span>Average Delivery</span>
                </div>

              </div>

            </div>


            {/* HERO FOOD CARD */}

            <div className="col-12 col-lg-5">

              <div className="hero-food-card">

                <div className="hero-food-image">
                  🍔
                </div>

                <div className="hero-food-info">

                  <div>

                    <h4>
                      Special Burger
                    </h4>

                    <p>
                      Cheese • Chicken • Fresh Veggies
                    </p>

                  </div>

                  <strong>
                    $8.99
                  </strong>

                </div>

                <div className="hero-rating">
                  ⭐ 4.9
                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      {/* ================= SEARCH ================= */}

      <section className="search-section">

        <div className="container">

          <div className="search-box">

            <span>🔍</span>

            <input
              type="text"
              placeholder="Search for restaurants, food or hotels..."
            />

            <button type="button">
              Search
            </button>

          </div>

        </div>

      </section>


      {/* ================= CATEGORIES ================= */}

      <section className="category-section">

        <div className="container">

          <div className="section-heading">

            <div>

              <span>
                EXPLORE
              </span>

              <h2>
                What are you craving?
              </h2>

            </div>

            <Link to="/restaurants">
              View All →
            </Link>

          </div>


          <div className="category-grid">

            {categories.map((category) => (

              <div
                className="category-card"
                key={category.name}
              >

                <div className="category-icon">
                  {category.icon}
                </div>

                <h4>
                  {category.name}
                </h4>

                <p>
                  {category.text}
                </p>

              </div>

            ))}

          </div>

        </div>

      </section>


      {/* ================= PROMO ================= */}

      <section className="promo-section">

        <div className="container">

          <div className="promo-card">

            <div className="promo-content">

              <span>
                SPECIAL OFFER
              </span>

              <h2>
                Get 30% OFF
                <br />
                on your first order!
              </h2>

              <p>
                Use code
                <strong> FOOD30 </strong>
                at checkout.
              </p>

              <Link to="/restaurants">
                Order Now →
              </Link>

            </div>

            <div className="promo-emoji">
              🍕
            </div>

          </div>

        </div>

      </section>


      {/* ================= RESTAURANTS ================= */}

      <section className="restaurant-section">

        <div className="container">

          <div className="section-heading">

            <div>

              <span>
                TOP PICKS
              </span>

              <h2>
                Popular Restaurants
              </h2>

            </div>

            <Link to="/restaurants">
              See All →
            </Link>

          </div>


          {/* LOADING */}

          {loadingRestaurants && (

            <div className="text-center py-5">

              <div className="spinner-border text-warning"></div>

              <p className="text-muted mt-3">
                Loading restaurants...
              </p>

            </div>

          )}


          {/* NO RESTAURANTS */}

          {!loadingRestaurants && restaurants.length === 0 && (

            <div className="text-center py-5">

              <div
                style={{
                  fontSize: "70px",
                }}
              >
                🍽️
              </div>

              <h3 className="fw-bold mt-3">
                No restaurants available
              </h3>

              <p className="text-muted">
                Restaurants added by the admin will
                appear here.
              </p>

              <Link
                to="/restaurants"
                className="btn btn-warning fw-bold mt-2"
              >
                View Restaurants
              </Link>

            </div>

          )}


          {/* RESTAURANT CARDS */}

          {!loadingRestaurants && restaurants.length > 0 && (

            <div className="row g-4">

              {restaurants.map((restaurant) => (

                <div
                  className="col-12 col-md-6 col-lg-4"
                  key={restaurant.id}
                >

                  <div className="restaurant-card">

                    {/* IMAGE */}

                    <div className="restaurant-image">

                      {restaurant.image ? (

                        <img
                          src={restaurant.image}
                          alt={restaurant.name}
                          loading="lazy"
                          onError={(e) => {
                            e.currentTarget.style.display =
                              "none";
                          }}
                        />

                      ) : (

                        <div
                          style={{
                            width: "100%",
                            height: "100%",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            fontSize: "100px",
                            background:
                              "linear-gradient(135deg,#fff0d0,#ffd27d)",
                          }}
                        >
                          🍽️
                        </div>

                      )}

                      <span className="restaurant-offer">
                        FREE DELIVERY
                      </span>

                    </div>


                    {/* RESTAURANT INFO */}

                    <div className="restaurant-info">

                      <div className="restaurant-title">

                        <div>

                          <h3>
                            {restaurant.name}
                          </h3>

                          <p>
                            {restaurant.type ||
                              "Restaurant"}
                          </p>

                        </div>

                        <span className="rating">
                          ⭐ {restaurant.rating || "0.0"}
                        </span>

                      </div>


                      {restaurant.description && (

                        <p
                          style={{
                            color: "#777",
                            fontSize: "13px",
                            marginTop: "8px",
                            marginBottom: "8px",
                          }}
                        >
                          {restaurant.description}
                        </p>

                      )}


                      <div className="restaurant-meta">

                        <span>
                          🛵{" "}
                          {restaurant.delivery_time ||
                            "20-30 min"}
                        </span>

                        <span>
                          •
                        </span>

                        <span>
                          📍{" "}
                          {restaurant.address ||
                            restaurant.location ||
                            "Nearby"}
                        </span>

                      </div>


                      <Link
                        to={`/restaurants/${restaurant.id}`}
                        className="view-menu-btn"
                      >
                        View Menu
                      </Link>

                    </div>

                  </div>

                </div>

              ))}

            </div>

          )}

        </div>

      </section>


      {/* ================= WHY FOOD EXPRESS ================= */}

      <section className="why-section">

        <div className="container">

          <div className="section-heading centered">

            <div>

              <span>
                WHY FOOD EXPRESS?
              </span>

              <h2>
                Food delivery made simple
              </h2>

            </div>

          </div>


          <div className="row g-4 mt-3">

            <div className="col-12 col-md-4">

              <div className="why-card">

                <div>
                  ⚡
                </div>

                <h3>
                  Fast Delivery
                </h3>

                <p>
                  Get your favorite meals delivered
                  quickly and safely.
                </p>

              </div>

            </div>


            <div className="col-12 col-md-4">

              <div className="why-card">

                <div>
                  🍽️
                </div>

                <h3>
                  Best Restaurants
                </h3>

                <p>
                  Discover amazing restaurants and
                  hotels near you.
                </p>

              </div>

            </div>


            <div className="col-12 col-md-4">

              <div className="why-card">

                <div>
                  💳
                </div>

                <h3>
                  Easy Checkout
                </h3>

                <p>
                  Simple ordering and secure checkout
                  every time.
                </p>

              </div>

            </div>

          </div>

        </div>

      </section>

    </div>
  );
}

export default Home;