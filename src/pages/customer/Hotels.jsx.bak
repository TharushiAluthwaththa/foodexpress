import React, { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import axios from "axios";

function Hotels() {
  const [hotels, setHotels] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    loadHotels();
  }, []);

  const loadHotels = async () => {
    try {
      const response = await axios.get(
        "http://127.0.0.1:8000/api/hotels"
      );

      console.log("HOTELS API RESPONSE:", response.data);
      console.log("HOTELS:", response.data.hotels);

      setHotels(response.data.hotels || []);
    } catch (error) {
      console.error(
        "Hotel loading error:",
        error.response?.data || error.message
      );

      setHotels([]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div
      style={{
        background: "#fffaf2",
        minHeight: "80vh",
        padding: "60px 0",
      }}
    >
      <div className="container">

        {/* HEADER */}
        <div className="text-center mb-5">
          <small
            style={{
              color: "#ff9f1c",
              fontWeight: "800",
              letterSpacing: "2px",
            }}
          >
            FOOD EXPRESS
          </small>

          <h1 className="fw-bold display-5">
            🏨 Hotels
          </h1>

          <p className="text-muted fs-5">
            Discover amazing hotels and order delicious food.
          </p>
        </div>

        {/* LOADING */}
        {loading && (
          <div className="text-center py-5">
            <div className="spinner-border text-warning"></div>

            <p className="text-muted mt-3">
              Loading hotels...
            </p>
          </div>
        )}

        {/* EMPTY */}
        {!loading && hotels.length === 0 && (
          <div className="text-center py-5">
            <div style={{ fontSize: "80px" }}>
              🏨
            </div>

            <h3 className="fw-bold mt-3">
              No hotels available
            </h3>

            <p className="text-muted">
              Hotels added by the admin will appear here.
            </p>
          </div>
        )}

        {/* HOTELS */}
        {!loading && hotels.length > 0 && (
          <div className="row g-4">

            {hotels.map((hotel) => (
              <div
                className="col-12 col-md-6 col-lg-4"
                key={hotel.id}
              >
                <div
                  className="card border-0 shadow-sm h-100"
                  style={{
                    borderRadius: "22px",
                    overflow: "hidden",
                  }}
                >

                  {/* IMAGE */}
                  <div
                    style={{
                      height: "220px",
                      background:
                        "linear-gradient(135deg,#fff0d0,#ffd27d)",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      overflow: "hidden",
                    }}
                  >
                    {hotel.image ? (
                      <img
                        src={hotel.image}
                        alt={hotel.name}
                        style={{
                          width: "100%",
                          height: "100%",
                          objectFit: "cover",
                        }}
                        onError={(e) => {
                          e.currentTarget.style.display = "none";
                        }}
                      />
                    ) : (
                      <span style={{ fontSize: "110px" }}>
                        🏨
                      </span>
                    )}
                  </div>

                  {/* CONTENT */}
                  <div className="card-body p-4">

                    <div className="d-flex justify-content-between align-items-start">

                      <div>
                        <h3 className="fw-bold mb-1">
                          {hotel.name}
                        </h3>

                        <p className="text-muted mb-2">
                          {hotel.type || "Hotel"}
                        </p>
                      </div>

                      <span className="badge bg-warning text-dark">
                        ⭐ {hotel.rating || "0.0"}
                      </span>

                    </div>

                    {hotel.description && (
                      <p className="text-muted">
                        {hotel.description}
                      </p>
                    )}

                    <p className="text-muted mb-2">
                      🛵{" "}
                      {hotel.delivery_time || "30-40 min"}
                    </p>

                    <p className="text-muted mb-3">
                      📍{" "}
                      {hotel.address ||
                        hotel.location ||
                        "Nearby"}
                    </p>

                    <Link
                      to={`/hotels/${hotel.id}`}
                      className="btn btn-warning w-100 py-2 fw-bold"
                    >
                      View Menu →
                    </Link>

                  </div>
                </div>
              </div>
            ))}

          </div>
        )}

      </div>
    </div>
  );
}

export default Hotels;