import React, { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import axios from "axios";

function Restaurant() {
  const [restaurants, setRestaurants] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    loadRestaurants();
  }, []);

  const loadRestaurants = async () => {
    try {
      const response = await axios.get(
        "http://127.0.0.1:8000/api/restaurants"
      );

      console.log("Customer Restaurants:", response.data);

      setRestaurants(response.data.restaurants || []);
    } catch (error) {
      console.error(
        "Restaurant loading error:",
        error.response?.data || error.message
      );

      setRestaurants([]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div
      style={{
        background: "#fffaf2",
        minHeight: "80vh",
        padding: "60px 0",
      }}
    >
      <div className="container">

        {/* HEADER */}
        <div className="text-center mb-5">

          <small
            style={{
              color: "#ff9f1c",
              fontWeight: "800",
              letterSpacing: "2px",
            }}
          >
            FOOD EXPRESS
          </small>

          <h1 className="fw-bold display-5">
            🍽️ Restaurants
          </h1>

          <p className="text-muted fs-5">
            Find your favorite restaurant and order delicious food.
          </p>

        </div>


        {/* LOADING */}
        {loading && (
          <div className="text-center py-5">

            <div className="spinner-border text-warning"></div>

            <p className="text-muted mt-3">
              Loading restaurants...
            </p>

          </div>
        )}


        {/* EMPTY */}
        {!loading && restaurants.length === 0 && (
          <div className="text-center py-5">

            <div
              style={{
                fontSize: "80px",
              }}
            >
              🍽️
            </div>

            <h3 className="fw-bold mt-3">
              No restaurants available
            </h3>

            <p className="text-muted">
              Restaurants added by the admin will appear here.
            </p>

          </div>
        )}


        {/* RESTAURANTS */}
        {!loading && restaurants.length > 0 && (
          <div className="row g-4">

            {restaurants.map((restaurant) => (

              <div
                className="col-12 col-md-6 col-lg-4"
                key={restaurant.id}
              >

                <div
                  className="card border-0 shadow-sm h-100"
                  style={{
                    borderRadius: "22px",
                    overflow: "hidden",
                  }}
                >

                  {/* IMAGE */}
                  <div
                    style={{
                      height: "210px",
                      background:
                        "linear-gradient(135deg,#fff0d0,#ffd27d)",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      overflow: "hidden",
                    }}
                  >

                    {restaurant.image ? (
                      <img
                        src={restaurant.image}
                        alt={restaurant.name}
                        style={{
                          width: "100%",
                          height: "100%",
                          objectFit: "cover",
                        }}
                        onError={(e) => {
                          e.currentTarget.style.display = "none";
                        }}
                      />
                    ) : (
                      <span
                        style={{
                          fontSize: "110px",
                        }}
                      >
                        🍽️
                      </span>
                    )}

                  </div>


                  {/* BODY */}
                  <div className="card-body p-4">

                    <div className="d-flex justify-content-between align-items-start">

                      <div>

                        <h3 className="fw-bold mb-1">
                          {restaurant.name}
                        </h3>

                        <p className="text-muted mb-2">
                          {restaurant.type || "Restaurant"}
                        </p>

                      </div>

                      <span className="badge bg-warning text-dark">
                        ⭐ {restaurant.rating || "0.0"}
                      </span>

                    </div>


                    {restaurant.description && (
                      <p className="text-muted">
                        {restaurant.description}
                      </p>
                    )}


                    <p className="text-muted">
                      🛵 {restaurant.delivery_time || "20-30 min"}
                    </p>


                    <p className="text-muted">
                      📍{" "}
                      {restaurant.address ||
                        restaurant.location ||
                        "Nearby"}
                    </p>


                    <Link
                      to={`/restaurants/${restaurant.id}`}
                      className="btn btn-warning w-100 py-2 fw-bold"
                    >
                      View Menu →
                    </Link>

                  </div>

                </div>

              </div>

            ))}

          </div>
        )}

      </div>
    </div>
  );
}

export default Restaurant;